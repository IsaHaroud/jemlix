# Jemlix server
HOST=127.0.0.1
PORT=3001

# Admin password for /admin and all write APIs.
# Leave empty ONLY for local dev (admin + writes become open, warning printed).
ADMIN_TOKEN=

# Default seller contact shown in the admin "contact" picker
DEFAULT_WHATSAPP=
DEFAULT_CHANNEL=

# Optional: default Telegram export folder for the importer (also passable as CLI arg)
# EXPORT_DIR=/path/to/ChatExport_2026-09-29

# Telegram bot (supplier onboarding + product intake).
# Create it with the official @BotFather. Empty = bot disabled.
# BOT_TOKEN=123456:ABC-def...
# Send /id to your new bot after its first start, then put the returned ID here.
# ADMIN_CHAT_ID=123456789

# Public URL included in the supplier /code response.
# Required when BOT_TOKEN is enabled in production. No trailing slash.
PUBLIC_BASE_URL=https://jemlix.com

# Optional independent secret for hashing supplier codes and sessions.
# Generate a long random value. If empty, BOT_TOKEN is used.
SUPPLIER_AUTH_SECRET=
